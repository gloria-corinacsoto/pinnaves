<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <record id="view_list_pin_naves_seguimiento" model="ir.ui.view">
        <field name="name">pin.naves.seguimiento.list</field>
        <field name="model">pin_naves.seguimiento</field>
        <field name="arch" type="xml">
            <list string="Seguimientos" decoration-danger="esUrgente">
                <field name="cliente_id"/>
                <field name="presupuesto_id"/>
                <field name="fechaContacto"/>
                <field name="fechaProximoContacto"/>
                <field name="dias_transcurridos"/>
                <field name="medioContacto"/>
                <field name="estadoSeguimiento"/>
                <field name="estadoCliente"/>
                <field name="esUrgente"/>
            </list>
        </field>
    </record>

   
    <record id="view_form_pin_naves_seguimiento" model="ir.ui.view">
        <field name="name">pin.naves.seguimiento.form</field>
        <field name="model">pin_naves.seguimiento</field>
        <field name="arch" type="xml">
            <form string="Seguimiento">
                <header>
                    <button name="action_poner_en_proceso" type="object" string="Poner en proceso"
                            invisible="estadoSeguimiento != 'pendiente'"/>
                    <button name="action_marcar_completado" type="object" string="Marcar completado"
                            class="btn-primary" invisible="estadoSeguimiento == 'completado'"/>
                </header>
                <sheet>
                    <field name="imagenSeguimiento" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="cliente_id"/>
                            <field name="presupuesto_id"/>
                            <field name="fechaContacto"/>
                            <field name="fechaProximoContacto"/>
                            <field name="dias_transcurridos"/>
                        </group>
                        <group>
                            <field name="fechaInscripcion"/>
                            <field name="medioContacto"/>
                            <field name="estadoSeguimiento"/>
                            <field name="estadoCliente"/>
                            <field name="duracionMinutos"/>
                            <field name="esUrgente"/>
                        </group>
                    </group>
                    <group>
                        <field name="notasSeguimiento"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

   
    <record id="view_search_pin_naves_seguimiento" model="ir.ui.view">
        <field name="name">pin.naves.seguimiento.search</field>
        <field name="model">pin_naves.seguimiento</field>
        <field name="arch" type="xml">
            <search string="Buscar Seguimientos">
                <field name="cliente_id"/>
                <field name="presupuesto_id"/>
                <field name="notasSeguimiento"/>

                <filter string="Pendientes" name="filtro_pendiente" domain="[('estadoSeguimiento', '=', 'pendiente')]"/>
                <filter string="En proceso" name="filtro_proceso" domain="[('estadoSeguimiento', '=', 'en_proceso')]"/>
                <filter string="Completados" name="filtro_completado" domain="[('estadoSeguimiento', '=', 'completado')]"/>
                <separator/>
                <filter string="Urgentes" name="filtro_urgente" domain="[('esUrgente', '=', True)]"/>
                <filter string="Interesados" name="filtro_interesado" domain="[('estadoCliente', '=', 'interesado')]"/>

                <group>
                    <filter string="Cliente" name="group_cliente" context="{'group_by': 'cliente_id'}"/>
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estadoSeguimiento'}"/>
                    <filter string="Medio de contacto" name="group_medio" context="{'group_by': 'medioContacto'}"/>
                </group>
            </search>
        </field>
    </record>

    
    <record id="view_calendar_pin_naves_seguimiento" model="ir.ui.view">
        <field name="name">pin.naves.seguimiento.calendar</field>
        <field name="model">pin_naves.seguimiento</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de seguimientos" date_start="fechaContacto"
                      color="cliente_id" mode="month" quick_create="0">
                <field name="cliente_id"/>
                <field name="estadoSeguimiento"/>
            </calendar>
        </field>
    </record>

   
    <record id="action_pin_naves_seguimiento" model="ir.actions.act_window">
        <field name="name">Seguimientos</field>
        <field name="res_model">pin_naves.seguimiento</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer seguimiento
            </p>
        </field>
    </record>

   
    <menuitem id="menu_pin_naves_seguimiento"
              name="Seguimientos"
              parent="menu_pin_naves_root"
              action="action_pin_naves_seguimiento"
              sequence="30"
              groups="base.group_user"/>

</odoo>