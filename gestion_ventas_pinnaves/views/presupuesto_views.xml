<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <record id="view_presupuesto_list" model="ir.ui.view">
        <field name="name">pin_naves.presupuesto.list</field>
        <field name="model">pin_naves.presupuesto</field>
        <field name="arch" type="xml">
            <list string="Lista de Presupuestos"
                  decoration-success="estadoPresupuesto == 'aprobado'"
                  decoration-danger="estadoPresupuesto == 'rechazado'">
                <field name="nombrePresupuesto"/>
                <field name="cliente_id"/>
                <field name="fechaVencimientoPresupuesto"/>
                <field name="diasRestantesPresupuesto"/>
                <field name="prioridadPresupuesto"/>
                <field name="estadoPresupuesto"/>
                <field name="totalPresupuesto" sum="Total"/>
            </list>
        </field>
    </record>

   
    <record id="view_presupuesto_form" model="ir.ui.view">
        <field name="name">pin_naves.presupuesto.form</field>
        <field name="model">pin_naves.presupuesto</field>
        <field name="arch" type="xml">
            <form string="Ficha del Presupuesto">
                <sheet>
                    <field name="imagenPresupuesto" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="nombrePresupuesto"/>
                            <field name="cliente_id"/>
                            <field name="prioridadPresupuesto"/>
                            <field name="estadoPresupuesto"/>
                        </group>
                        <group>
                            <field name="fechaCreacionPresupuesto"/>
                            <field name="fechaVencimientoPresupuesto"/>
                            <field name="diasRestantesPresupuesto"/>
                        </group>
                    </group>
                    <group>
                        <field name="descripcionPresupuesto"/>
                    </group>
                    <group>
                        <group>
                            <field name="precioUnitarioPresupuesto"/>
                            <field name="cantidadPresupuesto"/>
                        </group>
                        <group>
                            <field name="aplicaIvaPresupuesto"/>
                            <field name="importePresupuesto"/>
                            <field name="totalPresupuesto"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Seguimientos">
                            <field name="seguimiento_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_presupuesto_search" model="ir.ui.view">
        <field name="name">pin_naves.presupuesto.search</field>
        <field name="model">pin_naves.presupuesto</field>
        <field name="arch" type="xml">
            <search string="Buscar Presupuestos">
                <field name="nombrePresupuesto"/>
                <field name="cliente_id"/>
                <field name="descripcionPresupuesto"/>

                <filter name="filtro_pendiente" string="Pendientes"
                        domain="[('estadoPresupuesto', '=', 'pendiente')]"/>
                <filter name="filtro_aprobado" string="Aprobados"
                        domain="[('estadoPresupuesto', '=', 'aprobado')]"/>
                <filter name="filtro_rechazado" string="Rechazados"
                        domain="[('estadoPresupuesto', '=', 'rechazado')]"/>
                <filter name="filtro_alta" string="Prioridad alta"
                        domain="[('prioridadPresupuesto', '=', 'alta')]"/>
                <filter name="filtro_vencidos" string="Vencidos"
                        domain="[('fechaVencimientoPresupuesto', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>

                <group>
                    <filter name="group_estado" string="Estado"
                            context="{'group_by': 'estadoPresupuesto'}"/>
                    <filter name="group_cliente" string="Cliente"
                            context="{'group_by': 'cliente_id'}"/>
                    <filter name="group_prioridad" string="Prioridad"
                            context="{'group_by': 'prioridadPresupuesto'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_presupuesto" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">pin_naves.presupuesto</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <menuitem id="menu_pin_naves_presupuesto"
              name="Presupuestos"
              parent="menu_pin_naves_root"
              action="action_presupuesto"
              sequence="20"
              groups="base.group_user"/>

</odoo>